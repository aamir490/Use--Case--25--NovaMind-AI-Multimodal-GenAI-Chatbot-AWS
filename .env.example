# NovaMind configuration reference. The application does not auto-load .env.
# Export these settings in the launching process/container.
# No credentials belong in this file or in the source code.
# Optional saved attachment storage (existing resources only; see docs/task-3d-storage.md).
# NOVAMIND_DYNAMODB_TABLE=novamind-conversations
# NOVAMIND_S3_BUCKET=novamind-private-attachments

# Local mode (default): explicit named profile only; no default-profile fallback.
NOVAMIND_AWS_MODE=local
AWS_PROFILE=novamind
AWS_DEFAULT_REGION=us-east-1
# Configure local credentials separately: aws configure --profile novamind
# AWS_REGION, if set, must also equal us-east-1.
# AWS_DEFAULT_PROFILE, if set locally, must equal novamind.
# Conflicting region/profile or static AWS credential environment variables fail.

# Deployment: set NOVAMIND_AWS_MODE=task-role, remove AWS_PROFILE and
# AWS_DEFAULT_PROFILE, and attach an ECS task IAM role.
# Only the SDK container-role provider is enabled in task-role mode.
# No shared/default profiles, static environment keys, or EC2 metadata fallback.
# ECS deployment settings (inject secrets through ECS Secrets Manager references):
# COGNITO_USER_POOL_ID=<us-east-1 pool id>
# COGNITO_APP_CLIENT_ID=<public app client id; no client secret>
# NOVAMIND_AI_PROVIDER=groq  # or bedrock
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY is secret-injected; never put its value in task plaintext env.
# NOVAMIND_DYNAMODB_TABLE=novamind-conversations
# NOVAMIND_S3_BUCKET=novamind-private-attachments
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Bedrock precedence: explicit service/UI values > environment > defaults.
# Initial UI settings use these defaults; subsequent UI selections take priority.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.7
# BEDROCK_SYSTEM_PROMPT=You are a helpful assistant.

# Diagnostics are offline by default:
# python scripts/bedrock_model_access_check.py
# Explicit authorization for live identity/catalog checks:
# python scripts/bedrock_model_access_check.py --live-check
# Additional authorization for paid streaming checks:
# python scripts/bedrock_model_access_check.py --live-check --live-inference
